# --- build output ---------------------------------------------------------
node_modules/
.next/
.turbo/
dist/
build/
# ...but the two segmenter packages use "build/" as the electron-builder ICON
# directory (it holds the icon documentation), not as a build-output directory.
!packages/segmenter-app/build/
!packages/segmenter-web/build/
out/
coverage/
*.tsbuildinfo
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

