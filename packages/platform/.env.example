# === ff 公共（前后端共享） ===
NODE_ENV=development
WEB_UPLOADER_PORT=3001
WEB_ADMIN_PORT=3002
WORKER_PORT=3010

# === Postgres (容器或远端) ===
POSTGRES_HOST=localhost           # docker compose 用 pg；远端 PG 改 ip
POSTGRES_PORT=5432
POSTGRES_DB=ff
POSTGRES_USER=ff
POSTGRES_PASSWORD=ff
DATABASE_URL=postgresql://ff:ff@localhost:5432/ff?schema=ff
DATABASE_SCHEMA=ff

# === Redis ===
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# === Clerk SaaS ===
# 用户需去 https://dashboard.clerk.com 申请
# 应用创建后从 API Keys 复制
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
CLERK_WEBHOOK_SECRET=whsec_xxx

# === Clerk + Next.js 公网访问（Phase 1 验证用，可随便填） ===
NEXT_PUBLIC_APP_URL=http://localhost:3001
CLERK_JWT_KEY=

# === 腾讯云 COS（L1 中转） ===
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-shanghai
COS_BUCKET=ff-uploads-1300000000
COS_CDN_DOMAIN=
COS_TEMP_KEY_DURATION_SEC=3600
COS_SIGNED_URL_DURATION_SEC=900
COS_LIFECYCLE_TRANSITION_IA_DAYS=30
COS_LIFECYCLE_TRANSITION_ARCHIVE_DAYS=90
COS_LIFECYCLE_TRANSITION_DEEP_DAYS=180

# === 客户结算平台 COS（L1 同步目标，由 SCF 函数跨桶写入） ===
CLIENT_COS_BUCKET=
CLIENT_COS_REGION=
CLIENT_COS_SECRET_ID=
CLIENT_COS_SECRET_KEY=

# === 家用 Puller（L2 本地硬盘） ===
PULLER_LOCAL_ROOT=D:/ff-pull
PULLER_CRONTAB="0 */1 * * *"
PULLER_BANDWIDTH_MBPS=20

# === 夸克网盘（L3 异地灾备）===
QUARK_REMOTE_DIR=/ff-backup
QUARK_RCLONE_BWLIMIT="10M"
QUARK_CRON="0 3 1 */3 *"

# === SCF 云函数触发器 ===
SCF_FUNCTION_NAME=ff-cos-sync
SCF_TRIGGER_COS_BUCKET=ff-uploads-1300000000
SCF_TRIGGER_EVENT=cos:ObjectCreated:Put

# === 设备 Adapter（Phase 1+ 实现）===
FFMPEG_PATH=/usr/bin/ffmpeg
HMD_DECODER_PATH=
MCAP_EXTRACTOR_PATH=

# === BullMQ / 队列 ===
BULLMQ_PREFIX=ff
WORKER_DEVICE_SCAN_CONCURRENCY=4
WORKER_PREVIEW_CONCURRENCY=2
WORKER_PULLER_CONCURRENCY=1
WORKER_BACKUP_CONCURRENCY=1

# === Worker 备份 ===
BACKUP_CRON=0 3 * * *
CSV_ROTATION_KEEP=10
