{
  "name": "ff",
  "version": "0.2.0",
  "private": true,
  "description": "FrameForge — 视频录入员的 SOP 化工具（plan2：Next.js 15 + Clerk + Docker Compose + 4 设备适配）",
  "license": "MIT",
  "engines": {
    "node": ">=20.10",
    "pnpm": ">=10.0"
  },
  "packageManager": "pnpm@10.19.0",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build && pnpm -r --filter \"./apps/*\" build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "dev": "pnpm -r --parallel --filter \"./apps/*\" dev",
    "db:migrate": "pnpm --filter @ff/db-schema db:migrate",
    "db:seed": "pnpm --filter @ff/db-schema db:seed",
    "clean": "pnpm -r exec rm -rf dist .turbo node_modules/.cache .next"
  },
  "devDependencies": {
    "typescript": "5.5.4",
    "prettier": "3.3.3"
  }
}
