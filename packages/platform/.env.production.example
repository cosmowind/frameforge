# === FrameForge 生产环境变量模板（不入仓） ===
# 复制到服务器：cp .env.production.example /www/wwwroot/projects/ff/.env
# 然后 nano .env 填真值
# 永远不要 git add .env 或 commit

# === Node 环境 ===
NODE_ENV=production
WEB_UPLOADER_PORT=3001
WEB_ADMIN_PORT=3002
WORKER_PORT=3010

# === Postgres（你 8.x 主机，db: ff 已建，schema: ff 已有 v2 表） ===
# ⚠ 8.x 主机上需要允许 vps.example.com 访问（listen_addresses + pg_hba.conf）
DATABASE_URL=postgresql://ff_user:CHANGE_ME@8.x.x.x:5432/ff?schema=ff
DATABASE_SCHEMA=ff

# === Redis（localhost 6379）===
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379

# === 公网 URL（域名 + HTTPS）===
NEXT_PUBLIC_APP_URL=https://ff.your-domain.com

# === Clerk（生产 live key）===
# 没申请之前用 dev 模式跳过（占位 keys 时自动 dev 模式）
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_xxx
CLERK_SECRET_KEY=sk_live_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
CLERK_WEBHOOK_SECRET=whsec_xxx
CLERK_JWT_KEY=

# === 腾讯云 COS（暂未启用，phase 2 接）===
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-shanghai
COS_BUCKET=

# === 设备 Adapter 路径 ===
FFMPEG_PATH=/usr/bin/ffmpeg
HMD_DECODER_PATH=
MCAP_EXTRACTOR_PATH=

# === BullMQ ===
BULLMQ_PREFIX=ff
WORKER_DEVICE_SCAN_CONCURRENCY=4
WORKER_PREVIEW_CONCURRENCY=2
WORKER_PULLER_CONCURRENCY=1
WORKER_BACKUP_CONCURRENCY=1
