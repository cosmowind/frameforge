    "pg": "8.11.5",
    "drizzle-orm": "0.31.4",
    "pino": "9.2.0",
    "zod": "3.23.8",
    "@aws-sdk/client-s3": "3.600.0",
    "cos-nodejs-sdk-v5": "2.13.0",
    "dotenv": "16.4.5"
  },
  "devDependencies": {
    "@types/node": "20.14.2",
