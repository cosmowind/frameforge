# PostgreSQL 数据库连接串（必填，留空则回退到 CSV 模式）
# 格式: postgresql://用户:密码@主机:端口/数据库名
VIDEO_MANAGER_DB_DSN=postgresql://ffuser:changeme@db.example.com:5432/video_manager
